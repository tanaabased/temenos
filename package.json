    "test": "bun test",
    "lint:examples": "bun scripts/validate-examples-task.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.1",
